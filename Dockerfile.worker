# LiveKit voice worker — compile to ESM, run with node (not tsx) for lower idle RAM
FROM node:22-bookworm-slim AS deps
WORKDIR /app
COPY package.json package-lock.json ./
COPY packages/contracts/package.json ./packages/contracts/
COPY apps/worker/package.json ./apps/worker/package.json
RUN npm ci

FROM deps AS build
COPY tsconfig.json nest-cli.json ./
COPY packages/contracts ./packages/contracts
COPY apps/worker ./apps/worker
RUN npm run build:worker

FROM node:22-bookworm-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production
ENV PYTHONPATH=/app/apps/stt-sarvam
ENV SARVAM_STT_PLUGIN_URL=ws://127.0.0.1:8091/stt
ENV PATH="/opt/stt/bin:${PATH}"

# @livekit/rtc-node (Rust TLS) needs system root CAs; slim images omit them by default.
# Python venv hosts LiveKit's official sarvam.STTRealtime sidecar on loopback.
RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates python3 python3-pip python3-venv \
  && update-ca-certificates \
  && rm -rf /var/lib/apt/lists/*

COPY package.json package-lock.json ./
COPY --from=build /app/packages/contracts ./packages/contracts
RUN npm ci --omit=dev && npm cache clean --force
COPY --from=build /app/dist/apps/worker ./dist/apps/worker

COPY apps/stt-sarvam/requirements.txt ./apps/stt-sarvam/requirements.txt
RUN python3 -m venv /opt/stt \
  && /opt/stt/bin/pip install --no-cache-dir -r /app/apps/stt-sarvam/requirements.txt
COPY apps/stt-sarvam ./apps/stt-sarvam
COPY apps/worker/start-with-stt.sh /app/start-with-stt.sh
RUN chmod +x /app/start-with-stt.sh

# LiveKit agents connect outbound; health listens on 8081 in production mode.
# Sidecar: Python STTRealtime on 127.0.0.1:8091, then Node worker.
CMD ["/app/start-with-stt.sh"]
