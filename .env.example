# API
PORT=3000

# PostgreSQL (local service or docker-compose)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=callagent
DATABASE_PASSWORD=callagent
DATABASE_NAME=callagent

# JWT (Bearer access tokens)
JWT_SECRET=change-me-in-dev-use-a-long-random-string
JWT_EXPIRES_IN=8h
# Login abuse limits (in-process per API instance; keyed by route + IP + email)
# AUTH_LOGIN_MAX_ATTEMPTS=10
# AUTH_LOGIN_WINDOW_MS=60000

# Seeded platform admin (created on API startup if missing)
ADMIN_EMAIL=admin@local.dev
ADMIN_PASSWORD=Admin123!
ADMIN_NAME=Platform Admin

# LiveKit Cloud (from https://cloud.livekit.io project settings)
# API uses these to mint tokens + dispatch agents; worker uses them to register.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxx
LIVEKIT_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Must match ServerOptions.agentName in apps/worker (default call-agent)
LIVEKIT_AGENT_NAME=call-agent
# Call cost analysis uses published LiveKit list (overage) rates — no markup.
# Plan picks WebRTC/SIP/STT/TTS scale discounts. Inference LLM rates are the same.
# LIVEKIT_PRICING_PLAN=ship
# true only if the worker is deployed as a LiveKit Cloud agent (charges $0.01/min session).
# Self-hosted Railway worker stays false (agent counts as WebRTC minutes instead).
# LIVEKIT_AGENT_DEPLOYED=false
# Optional SIP carrier estimate (Telnyx/Twilio), USD per minute. Default 0 = LiveKit only.
# LIVEKIT_SIP_VENDOR_USD_PER_MIN=0
# Pre-warmed LiveKit job child processes (worker only). Default 1 to limit idle RAM.
# Production SDK default is min(CPU, 4) if unset in code; do not set 0 (SDK treats 0 as unset).
# LIVEKIT_NUM_IDLE_PROCESSES=1

# OpenAI (worker only). Required for OpenAI LLM, gpt-4o-mini-tts, and Realtime jobs.
# Never put this in Vite / browser env. Missing key fails those jobs (no silent Gemma fallback).
# OPENAI_API_KEY=sk-xxxxxxxx

# xAI (worker only). Required for Grok LLM, Grok TTS, and Grok Voice realtime jobs.
# Never put this in Vite / browser env. Missing key fails those jobs.
# XAI_API_KEY=xai-xxxxxxxx

# Worker → API callbacks (transcript / usage after a call)
# API and worker must share WORKER_CALLBACK_SECRET
WORKER_CALLBACK_SECRET=change-me-worker-callback-secret
# Base URL the worker uses to reach the API (no trailing slash)
API_BASE_URL=http://localhost:3000
# Complete callback retry (worker only). Hung fetch is aborted per attempt.
# COMPLETE_CALLBACK_TIMEOUT_MS=8000
# COMPLETE_CALLBACK_MAX_ATTEMPTS=5
# COMPLETE_CALLBACK_BACKOFF_MS=500

# Optional SIP defaults (prefer org-linked trunks via admin API)
# LIVEKIT_SIP_OUTBOUND_TRUNK_ID=ST_xxxxxxxx
# LIVEKIT_SIP_OUTBOUND_NUMBER=+15551234567
# LIVEKIT_SIP_WAIT_UNTIL_ANSWERED=false
# LIVEKIT_SIP_DEFAULT_COUNTRY_CODE=91

# Outbound dial queue (runs inside the Nest API process)
# QUEUE_DIALER_ENABLED=true
# QUEUE_CLAIM_LEASE_SECONDS=120
# Fail/requeue dialing|ready rows that never get worker complete (frees max_concurrent)
# QUEUE_STALE_DIALING_SECONDS=180
# QUEUE_STALE_READY_SECONDS=900
# Must match SIP provider concurrent channel limit (1 = one live call at a time)
# QUEUE_DEFAULT_MAX_CONCURRENT=1
# QUEUE_DEFAULT_MAX_DIALS_PER_MINUTE=30
# QUEUE_DEFAULT_MAX_ATTEMPTS=3

# Plunk (transactional email). Leave PLUNK_API_KEY empty to soft-disable.
# Invites / password-reset / change-password mail will silently no-op without this.
# From address must use a domain verified in Plunk.
# PLUNK_API_KEY=sk_xxxxxxxx
# Origin only (do not include /v1/send). Current hosted: https://next-api.useplunk.com
# Legacy hosted Plunk (app.useplunk.com): https://api.useplunk.com
# PLUNK_API_BASE=https://next-api.useplunk.com
# EMAIL_FROM=Speeko <hello@speeko.ai>
# Optional platform inbox for future contact/lead notifications
# EMAIL_NOTIFY_TO=you@example.com
# Public portal origin used in invite / reset links
# PORTAL_PUBLIC_URL=http://localhost:5174
# PASSWORD_INVITE_TTL_MS=604800000
# PASSWORD_RESET_TTL_MS=3600000

# CORS (production web origin). Comma-separated; unset reflects request origin (dev).
# CORS_ORIGIN=https://your-web.up.railway.app

# Marketing get-demo form → integration dial (API only; never put SPEEKO_API in Vite)
# POST /api/demo/request proxies to ENDPOINT_URL with Bearer SPEEKO_API
# ENDPOINT_URL=https://your-api.example/api/integrations/<publicId>/calls
# SPEEKO_API=ca_live_xxxxxxxx
# Public get-demo abuse limits (in-process per API instance)
# DEMO_MAX_PER_IP=5
# DEMO_IP_WINDOW_MS=900000
# DEMO_MAX_PER_PHONE=1
# DEMO_PHONE_WINDOW_MS=3600000
# DEMO_MAX_PER_EMAIL=2
# DEMO_EMAIL_WINDOW_MS=3600000
# DEMO_MAX_GLOBAL=30
# DEMO_GLOBAL_WINDOW_MS=3600000

# GoHighLevel (API only). Never put these in Vite / portal / worker env.
# Get-demo CRM upsert: both required or CRM no-ops. Calendar tools do NOT use these —
# orgs add a GHL connection in the portal (PIT + location + calendar) and link it on an agent.
# GHL_API_KEY=pit-xxxxxxxx
# GHL_LOCATION_ID=your_location_id
# Optional leftovers (unused by org GHL tools):
# GHL_CALENDAR=pit-xxxxxxxx
# GHL_CALENDAR_ID=your_ghl_calendar_id
