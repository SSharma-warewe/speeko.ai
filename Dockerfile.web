# Marketing site (Vite SPA) — landing, demo, solutions
FROM node:22-bookworm-slim AS build
WORKDIR /app

# UI kit + contracts (source imported via Vite alias)
COPY packages/ui/package.json packages/ui/package-lock.json ./packages/ui/
RUN cd packages/ui && npm ci --legacy-peer-deps

COPY apps/web/package.json apps/web/package-lock.json ./apps/web/
# react-bubble-ui peers React 16; app runs React 19 — same as local install
RUN cd apps/web && npm ci --legacy-peer-deps

COPY packages/ui ./packages/ui
COPY packages/contracts ./packages/contracts
COPY apps/web ./apps/web

# Injected at build time (Railway service variables)
ARG VITE_PORTAL_URL
ENV VITE_PORTAL_URL=${VITE_PORTAL_URL}
ARG VITE_API_URL
ENV VITE_API_URL=${VITE_API_URL}

WORKDIR /app/apps/web
RUN npm run build

FROM node:22-bookworm-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production
RUN npm install -g serve@14
COPY --from=build /app/apps/web/dist ./dist
EXPOSE 3000
# Do not use `serve -s`: SPA fallback would serve homepage HTML for every
# path and collapse crawlable per-route shells (unique title + canonical).
# Railway injects PORT; default 3000 for local docker runs
CMD ["sh", "-c", "serve dist -l tcp://0.0.0.0:${PORT:-3000}"]
